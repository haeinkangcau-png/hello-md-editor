{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hi MD Editor",
  "version": "1.7.1",
  "identifier": "com.neurophet.mdviewer",
  "build": {
    "frontendDist": "../../../dist",
    "devUrl": "http://localhost:5174",
    "beforeDevCommand": "npm run --prefix ../.. dev:web",
    "beforeBuildCommand": "npm run --prefix ../.. build:web"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Hi MD Editor",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["md"],
        "name": "Markdown Document",
        "description": "Markdown 문서",
        "role": "Editor"
      },
      {
        "ext": ["html", "htm"],
        "name": "HTML Document",
        "description": "HTML 문서",
        "role": "Editor"
      }
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
